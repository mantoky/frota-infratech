rules_version = '2';

// A operação não tem conta. Qualquer pessoa com o app lê e grava a frota,
// a estrutura e o fórum. A senha de administrador só esconde botões no
// navegador; ela não é uma trava do banco.
//
// O que continua garantido é a forma dos campos: veículo e histórico são
// listas, e uma mensagem nova nasce com título, texto e zero curtidas.

service cloud.firestore {
  match /databases/{database}/documents {

    match /frota/data {
      allow read: if true;

      allow write: if request.resource.data.vehicles is list
                   && (!('history' in request.resource.data)
                       || request.resource.data.history is list)
                   && (!('drivers' in request.resource.data)
                       || request.resource.data.drivers is list);
    }

    match /org/data {
      allow read: if true;
      allow write: if request.resource.data.units is list;
    }

    match /forumPosts/{postId} {
      allow read: if true;

      allow create: if request.resource.data.title is string
                    && request.resource.data.content is string
                    && request.resource.data.likes == 0;

      allow update, delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
