rules_version = '2';

// FASE 0 - CONTENCAO DE SEGURANCA
//
// A versao anterior declarava `allow read: if true` no documento da frota.
// Como o `projectId` esta no bundle JavaScript por construcao, isso significava
// que qualquer pessoa com o endereco do app lia a frota inteira: placas,
// condutores, quilometragem, observacoes e coordenadas de GPS. Fechado aqui.
//
// LIMITACAO CONHECIDA DESTA FASE: o nivel de acesso e lido do documento
// `users/{uid}` via `get()`, e nao de custom claim. Isso custa UMA LEITURA por
// avaliacao de regra e nao e o desenho final - as claims entram na Fase 1,
// junto com as Cloud Functions que sabem grava-las. A escolha aqui e
// deliberada: sem Functions ainda, `get()` e a unica forma correta de
// verificar nivel, e correto-e-caro vence rapido-e-inseguro.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function profileExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Estar autenticado nao basta: a conta precisa ter sido aprovada. Todo
    // autocadastro nasce `pendente` e nao enxerga nada ate um administrador
    // ou operador liberar. Ver docs/REQUISITOS_V2.md secao 1.2.
    function ativo() {
      return signedIn() && profileExists() && profile().status == 'ativo';
    }

    function nivel() {
      return profile().level;
    }

    function ehAdmin() {
      return ativo() && nivel() in ['admin', 'admin_master'];
    }

    function ehOperadorOuAcima() {
      return ativo() && nivel() in ['operador', 'admin', 'admin_master'];
    }

    // ---------- users ----------

    match /users/{uid} {
      // O proprio perfil sempre; os demais, apenas operador ou acima - e quem
      // precisa aprovar cadastros e administrar pessoas.
      allow read: if signedIn() && (request.auth.uid == uid || ehOperadorOuAcima());

      // Autocadastro: a pessoa cria o proprio documento, e SO com nivel comum
      // e status pendente. Sem esta trava, bastaria uma escrita direta pelo SDK
      // para nascer administrador - exatamente o tipo de falha que uma regra
      // permissiva demais produz.
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.level == 'usuario'
                    && request.resource.data.status == 'pendente'
                    && request.resource.data.email == request.auth.token.email;

      // O usuario comum edita apenas dados seus que nao afetam permissao.
      // `level` e `status` ficam de fora de proposito: sao o que define poder.
      allow update: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['displayName', 'declarado', 'preferencias', 'lastLoginAt']);

      // Administrador aprova, bloqueia e ajusta nivel. A invariante "ninguem
      // concede nivel igual ou superior ao seu" ainda nao cabe aqui: depende de
      // comparar postos, que e trabalho de Function. Entra na Fase 1.
      allow update: if ehAdmin();

      // Exclusao e sempre logica (status: 'inativo'). Apagar o documento
      // quebraria toda referencia de historico e auditoria.
      allow delete: if false;
    }

    // ---------- frota (documento unico, ainda da v1) ----------

    match /frota/data {
      allow read: if ativo();

      // `hasAll(['vehicles','history'])` estava aqui e teria bloqueado a
      // correcao da perda de frota: a semeadura deixou de enviar `history` de
      // proposito - mandar `[]` junto foi o que destruiu o historico real.
      // Num documento que ainda nao existe, o resultado da mesclagem tambem
      // nao teria a chave, e a gravacao seria negada.
      //
      // O que continua garantido e o que importa: se a chave vier, ela e uma
      // lista. Nenhuma escrita consegue trocar o tipo do campo.
      allow write: if ativo()
                   && request.resource.data.vehicles is list
                   && (!('history' in request.resource.data)
                       || request.resource.data.history is list)
                   && (!('drivers' in request.resource.data)
                       || request.resource.data.drivers is list);
    }

    // ---------- estrutura organizacional ----------

    // Regional > Gerencia > Coordenacao > Gestao > Area, num documento unico.
    // Todo mundo ativo le - a arvore aparece em quase toda tela e e o que
    // amarra veiculo, checklist e escopo de mensagem. Escrever e outra coisa:
    // mexer na hierarquia muda quem enxerga o que, entao fica com operador
    // ou acima.
    match /org/data {
      allow read: if ativo();
      allow write: if ehOperadorOuAcima()
                   && request.resource.data.units is list;
    }

    // ---------- forum ----------

    // Colecao, e nao array dentro de um documento, justamente por causa
    // destas regras: num array, quem pode escrever no documento reescreve a
    // mensagem de qualquer um. Aqui a posse e por documento.
    match /forumPosts/{postId} {
      allow read: if ativo();

      // A autoria e conferida contra o token, nao aceita do cliente. Era um
      // campo de texto livre antes - qualquer pessoa assinava como qualquer
      // outra, o que anula qualquer trilha de auditoria.
      allow create: if ativo()
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.likes == 0
                    && request.resource.data.title is string
                    && request.resource.data.content is string;

      // Tres caminhos distintos, de proposito:
      //   1. o autor edita a propria mensagem;
      //   2. o administrador modera qualquer uma;
      //   3. qualquer pessoa ativa pode curtir ou comentar - e SO isso, com
      //      `hasOnly` impedindo que um "comentario" venha acompanhado de uma
      //      troca sorrateira de autor ou de conteudo.
      allow update: if ativo() && (
                      resource.data.authorUid == request.auth.uid
                      || ehAdmin()
                      || request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['likes', 'comments'])
                    );

      // Apagar: o dono ou o administrador. Ninguem mais.
      allow delete: if ativo() && (
                      resource.data.authorUid == request.auth.uid || ehAdmin()
                    );
    }

    // ---------- padrao ----------

    // Nega qualquer outro documento ou colecao. As colecoes da Fase 1
    // (orgUnits, vehicles, movements, auditLogs) entram com regra propria.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
